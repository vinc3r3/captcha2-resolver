# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Collection (c2r collect) ---
# Page that renders a captcha. Intentionally not documented in this repo.
CAPTCHA_SOURCE_URL=https://example.com/page-with-captcha
# CSS selector of the element that carries the captcha image
# (an <img src="data:..."> or an element with style="background-image: url(data:...)").
CAPTCHA_SELECTOR=.captcha

# --- Labeling (c2r label rucaptcha) ---
RUCAPTCHA_API_KEY=

# --- Hugging Face Hub (c2r hub ...) ---
HF_TOKEN=
HF_DATASET_REPO=your-username/captcha2-dataset
HF_MODEL_REPO=your-username/captcha2-resolver-onnx
